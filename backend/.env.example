# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (CORS)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting (15 minutes, 100 requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------------------
# Supabase PostgreSQL Database Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string
# ----------------------------------------------------
# For Transaction Pooler (Session / PgBouncer mode - recommended for serverless or production):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# For Direct Connection (Direct port 5432 - used for migrations & local development):
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
